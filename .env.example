# Database
DATABASE_URL=mysql://user:password@host:3306/studynivo

# Required for signed StudyNivo sessions (32+ random characters)
STUDYNIVO_SESSION_SECRET=replace-with-at-least-32-random-characters

# StudyNivo uses email/password or phone/password authentication.
# No Google, Apple, Microsoft, SMS, or OAuth keys are required.
# Password reset email delivery through Gmail SMTP + App Password
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=16-character-app-password
GMAIL_SMTP_FROM_EMAIL=verified-send-as-address@example.com

# Optional free/trial AI fallback. MANUS_API_URL/MANUS_API_KEY take priority.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
