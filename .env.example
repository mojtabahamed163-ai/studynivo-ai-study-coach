# Database
DATABASE_URL=mysql://user:password@host:3306/studynivo

# Required for StudyNivo's own signed session cookie (32+ random characters)
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth: callback https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID OAuth: callback https://YOUR_DOMAIN/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple Sign in with Apple: callback https://YOUR_DOMAIN/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
